<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:animateLayoutChanges="true"
  android:orientation="vertical"
  tools:ignore="RtlCompat">

  <com.google.android.material.appbar.AppBarLayout
    android:id="@+id/appbar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_behavior="com.google.android.material.appbar.AppBarLayout$Behavior"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent"
    android:fitsSystemWindows="true">

      <com.google.android.material.appbar.MaterialToolbar
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/app_name"
        app:titleTextAppearance="@style/TextAppearance.AndroidIDE.TitleLarge.Bold"
        app:titleCentered="true" />

  </com.google.android.material.appbar.AppBarLayout>

  <FrameLayout
    android:id="@+id/fragment_containers_parent"
    android:layout_width="0dp"
    android:layout_height="0dp"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@id/appbar">

    <com.google.android.material.card.MaterialCardView
      android:id="@+id/setup_banner"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_gravity="top"
      android:layout_margin="12dp"
      android:clickable="true"
      android:focusable="true"
      android:visibility="gone"
      app:cardBackgroundColor="?attr/colorSurfaceContainerHighest"
      app:cardCornerRadius="16dp"
      app:elevation="6dp"
      tools:visibility="visible">

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageView
          android:layout_width="28dp"
          android:layout_height="28dp"
          android:layout_gravity="center_vertical"
          android:contentDescription="@null"
          android:src="@drawable/ic_alert" />

        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginStart="12dp"
          android:layout_marginEnd="12dp"
          android:layout_weight="1"
          android:orientation="vertical">

          <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_setup_not_completed"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textStyle="bold" />

          <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/msg_setup_not_completed"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
          android:id="@+id/btn_setup_now"
          style="@style/Widget.Material3.Button.TextButton"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/action_setup" />

      </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <androidx.fragment.app.FragmentContainerView
      android:id="@+id/main"
      android:name="dev.apexstudio.ide.fragments.MainFragment"
      android:layout_width="match_parent"
      android:layout_height="match_parent" />

    <androidx.fragment.app.FragmentContainerView
      android:id="@+id/template_list"
      android:name="dev.apexstudio.ide.fragments.TemplateListFragment"
      android:layout_width="match_parent"
      android:layout_height="match_parent" />

    <androidx.fragment.app.FragmentContainerView
      android:id="@+id/template_details"
      android:name="dev.apexstudio.ide.fragments.TemplateDetailsFragment"
      android:layout_width="match_parent"
      android:layout_height="match_parent" />
      
    <androidx.fragment.app.FragmentContainerView
      android:id="@+id/clone_repository_view"
      android:name="dev.apexstudio.ide.fragments.CloneRepositoryFragment"
      android:layout_width="match_parent"
      android:layout_height="match_parent" 
      android:visibility="gone" />
      
      <androidx.fragment.app.FragmentContainerView
            android:id="@+id/saved_projects_view"
            android:name="dev.apexstudio.ide.fragments.RecentProjectsFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
      
      <androidx.fragment.app.FragmentContainerView
            android:id="@+id/delete_projects_view"
            android:name="dev.apexstudio.ide.fragments.DeleteProjectFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
            

  </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
