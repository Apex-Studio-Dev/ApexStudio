<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_setup"
        android:textAppearance="@style/TextAppearance.AndroidIDE.TitleLarge.Bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/subtitle_setup"
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/terminal_box"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_marginTop="24dp"
        app:cardBackgroundColor="#FF0B0D12"
        app:cardCornerRadius="16dp"
        app:elevation="0dp"
        app:strokeColor="#22FFFFFF"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_setup_terminal"
                    android:textColor="#80FFFFFF"
                    android:textAllCaps="true"
                    android:textSize="11sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/terminal_spinner"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    app:indeterminate="true"
                    app:indicatorColor="#80FFFFFF"
                    app:indicatorSize="16dp"
                    app:trackThickness="1.5dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#22FFFFFF" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/terminal_progress"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                app:indeterminate="true"
                app:indicatorColor="?attr/colorPrimary"
                app:showTrack="false"
                app:trackCornerRadius="2dp" />

            <ScrollView
                android:id="@+id/terminal_scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true">

                <TextView
                    android:id="@+id/tv_terminal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="2sp"
                    android:padding="12dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp"
                    android:textIsSelectable="true" />
            </ScrollView>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginTop="16dp"
        android:text="@string/status_setup_installing"
        android:textAppearance="@style/TextAppearance.Material3.BodySmall" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_continue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:enabled="false"
        android:text="@string/action_continue" />
</LinearLayout>